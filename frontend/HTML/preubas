<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reseñas - Huerta Automatizada</title>
    <link rel="stylesheet" href="/frontend/ESTILOS/resenas.css">

</head>

<body>
    <div class="navbar">
        <h1>🌿 Huerta Automatizada</h1>
        <span>Reseñas</span>
    </div>

    <div class="container">
        <h2>💬 Deja tu reseña</h2>
        <form id="formulario">
            <input type="text" id="nombre" placeholder="Tu nombre" required />
            <textarea id="mensaje" placeholder="Escribe tu reseña..." required></textarea>
            <button type="submit">Publicar reseña</button>
        </form>

        <h2>📖 Reseñas de otros usuarios</h2>
        <div class="reseñas" id="listaReseñas">
            <!-- Aquí se mostrarán las reseñas -->
        </div>
    </div>

    <script>
        // 🔹 Simular permiso (si no hay acceso, redirigir)
        const accesoPermitido = true; // cámbialo a false para probar redirección
        if (!accesoPermitido) {
            window.location.href = "/index.html";
        }

        const formulario = document.getElementById('formulario');
        const listaReseñas = document.getElementById('listaReseñas');

        // 🔹 Reseñas precargadas (simuladas desde una base de datos)
        const reseñasIniciales = [{
            nombre: "María López",
            mensaje: "Excelente sistema, mis plantas están más sanas que nunca 🌱."
        }, {
            nombre: "Carlos Ramírez",
            mensaje: "Fácil de usar y muy útil para controlar el riego automáticamente."
        }, {
            nombre: "Lucía Fernández",
            mensaje: "Me encanta cómo puedo monitorear todo desde mi celular 📱."
        }, {
            nombre: "Javier Torres",
            mensaje: "Instalación sencilla y resultados sorprendentes. 100% recomendado!"
        }];

        // 🔹 Cargar reseñas guardadas en localStorage
        const reseñasGuardadas = JSON.parse(localStorage.getItem('reseñas')) || [];

        // 🔹 Si no hay reseñas guardadas, agregamos las iniciales
        if (reseñasGuardadas.length === 0) {
            localStorage.setItem('reseñas', JSON.stringify(reseñasIniciales));
        }

        // 🔹 Mostrar todas las reseñas (guardadas o iniciales)
        const reseñasParaMostrar = JSON.parse(localStorage.getItem('reseñas'));
        reseñasParaMostrar.forEach(r => mostrarReseña(r.nombre, r.mensaje));

        // 🔹 Agregar nueva reseña
        formulario.addEventListener('submit', function(e) {
            e.preventDefault();

            const nombre = document.getElementById('nombre').value.trim();
            const mensaje = document.getElementById('mensaje').value.trim();

            if (nombre && mensaje) {
                const nuevaReseña = {
                    nombre,
                    mensaje
                };

                mostrarReseña(nombre, mensaje);

                // Guardar en localStorage al inicio del array
                reseñasParaMostrar.unshift(nuevaReseña);
                localStorage.setItem('reseñas', JSON.stringify(reseñasParaMostrar));

                formulario.reset();

                // Confirmación visual
                alert("✅ ¡Tu reseña se publicó correctamente!");
            }
        });

        // 🔹 Función para mostrar reseña
        function mostrarReseña(nombre, mensaje) {
            const reseña = document.createElement('div');
            reseña.classList.add('reseña');
            reseña.innerHTML = `<strong>${nombre}</strong><p>${mensaje}</p>`;
            listaReseñas.prepend(reseña);
        }
    </script>
</body>

</html>